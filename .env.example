# GitHub Personal Access Token
# Required scope: repo  (grants access to list private repositories)
# Create at: https://github.com/settings/tokens/new?scopes=repo
#
# CLI name is GITHUB_TOKEN. In GitHub Actions, set GH_BACKUP_TOKEN instead
# (the Action maps it to GITHUB_TOKEN so the default workflow token is not used).
GITHUB_TOKEN=

# GitLab Personal Access Token
# Required scope: api  (grants access to create projects)
# Create at: https://gitlab.com/-/user_settings/personal_access_tokens
GITLAB_TOKEN=
